# ===== AI Gateway — نموذج متغيرات البيئة =====
# انسخه إلى .env ثم املأ ما تحتاجه.
# ملاحظة مهمة: المفاتيح الحقيقية تُدار من الواجهة وتُخزَّن في data/gateway.db
# (لا في هذا الملف). مفاتيح .env تُقرأ كقيمة مبدئية عند الإقلاع فقط — لذا
# هذا الملف مرجع أسماء متغيرات، لا مكان أسرار دائم.

# ----- قيود الشبكة -----
# محلي فقط افتراضياً. لفتحه على الشبكة: HOST=0.0.0.0 (حينها ADMIN_TOKEN إلزامي)
HOST=127.0.0.1
PORT=3001
# توكن حماية كل مسارات /api — إلزامي إذا كان HOST غير محلي
ADMIN_TOKEN=
# أصول CORS المسموحة (مفصولة بفواصل)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# سماح بالاتصال بمزود على شبكتك المحلية (vLLM/LM Studio على 192.168.x.x).
# 169.254.x محجوب دائماً (بيانات وصفية سحابية) ولا يتأثر بهذا المتغير.
ALLOW_PRIVATE_HOSTS=

# ----- حدود المعدل (طلبات/دقيقة) -----
# /v1 يستهلك حصة المزود: ارفعه لو شغّلت وكيل برمجة مكثفاً
RATE_LIMIT_V1_PER_MIN=300
# /api/probe يطلق عشرات المحادثات لكل ضغطة: اخفضه على مزودين محدودي الحصة
RATE_LIMIT_PROBE_PER_MIN=60

# ----- مفاتيح المزودات (اختيارية — الأفضل إضافتها من الواجهة) -----
# OpenAI        https://platform.openai.com/api-keys
OPENAI_API_KEY=
# xAI / Grok    https://console.x.ai
XAI_API_KEY=
# Perplexity    https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# OpenRouter    https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek      https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Z.AI / GLM    https://z.ai/manage-apikey
ZAI_API_KEY=
# Google AI Studio (Gemini)  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (حصة مجانية سخية)  https://console.groq.com/keys
GROQ_API_KEY=
# Mistral       https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# Together AI   https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Fireworks     https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# Cerebras      https://cloud.cerebras.ai/register
CEREBRAS_API_KEY=
# Chutes (مجاني) https://chutes.ai/app/settings
CHUTES_API_KEY=
# NVIDIA NIM    https://build.nvidia.com
NVIDIA_API_KEY=
# مفتاح تشفير أسرار المخزون (AES-256-GCM) — اختياري
# إن لم يُضبط، يُنشئ الخادم تلقائياً ملف data/.credkey عند الإقلاع الأول.
# اضبطه إن كنت تريد إدارة المفتاح بنفسك أو نسخه للاستعادة على جهاز آخر.
# CRED_KEY=أي-عبارة-سرية-طويلة-أو-64-حرف-hex

# ===== مصادر الأسرار (هرمية السلطة: الأصغر يفوز) =====
# 1) HashiCorp Vault (KV v2) — الأعلى سلطة. المسار يحمل كائناً: اسم الحقل = معرّف المزود
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=ai-gateway/keys
VAULT_NAMESPACE=
# 2) Doppler
DOPPLER_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=
# 3) 1Password Connect — عنوان كل حقل = معرّف المزود
OP_CONNECT_HOST=
OP_CONNECT_TOKEN=
OP_VAULT_ID=
OP_ITEM_ID=
# 4) ملف محلي — يغطي تصدير أي مدير أسرار بلا تكامل إضافي.
#    الصيغة: {"groq":"gsk_...","openrouter":["sk-or-a","sk-or-b"]}
SECRETS_FILE=data/secrets.json
# 5) متغيّرات البيئة (*_API_KEY) — الأدنى، تُقرأ من قائمة الكتالوج + أي *_API_KEY

# ===== الوكلاء (إشراف ذاتي التشغيل) =====
# AGENTS_ENABLED=0 يعطّل كل الوكلاء (فحص يدوي فقط)
AGENTS_ENABLED=1
# نافذة المشرف: كل tick ينفّذ المهمّات المستحقّة
AGENT_TICK_MS=15000
# فترات المهمّات (بالمللي ثانية)
AGENT_SYNC_INTERVAL_MS=300000
AGENT_ROTATION_INTERVAL_MS=60100
AGENT_HEALTH_INTERVAL_MS=60100
AGENT_DRIFT_INTERVAL_MS=60100
# سياسة الاحتفاظ بالسجلات (تنظيف دوري يمنع نموّ القاعدة بلا حدّ)
AGENT_RETENTION_INTERVAL_MS=21600000
RETENTION_EVENTS_DAYS=30
RETENTION_USAGE_DAYS=90
RETENTION_ROTATIONS_KEEP=5000
# ذاكرة قوائم النماذج (كل هذا يقلّل الضرب على المزوّدات من 3s إلى ~0.3s)
MODELS_CACHE_TTL_MS=60000

# مفتاح البوابة نفسه (لعملاء البرمجة) — والواجهة تولّده وتديره
# سيُدار من data/gateway.db عبر /api/keys
