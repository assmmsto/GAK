# ===== أسرار وبيانات تشغيل — لا تُرفع أبداً =====
# خطأ حرج سابق: كانت كل الأنماط في سطر واحد، وgitignore يقرأ السطر الواحد
# نمطاً واحداً → لم يُستثنَ شيء إطلاقاً، فكان .env وقاعدة المفاتيح مرشّحين للرفع.
.env
.env.local
.env.*.local

# قاعدة البيانات ومفاتيح التشفير (المفاتيح تعيش بداخلها)
*.db
*.db-journal
*.db-wal
*.db-shm
# نسخ احتياطية للقاعدة — النمط *.db لا يطابق gateway.db.bak-<ts>
*.db.bak
*.db.bak-*
data/.credkey

# نسخ احتياطية للمصدر — قد تحمل أسراراً أو منطقاً قديماً
*.bak
*.bak-*
*.bak2

# مخرجات الفحوصات المؤقتة (تُولَّد محلياً)
*-out.txt
# ملف اسمه nul يتكوّن عرضاً على ويندوز ويُربك الأدوات
nul

# مخرجات بناء وسجلات
dist/
*.log
coverage/
*.tsbuildinfo

# نظام التشغيل والمحرر
.DS_Store
Thumbs.db

# اعتمادات
node_modules/

# حالة أدوات التطوير (ليست من المشروع)
.mimosa/
.workbuddy-ai/
.freebuff/
staged.txt
tests/_shots/
data/.testkeys.json
# مجلد النسخ الاحتياطية (يحتوي .credkey — لا يُرفع أبداً)
data/backups/
